# =====================================================================
# Decision Cockpit — 環境変数テンプレート
# 実値はここに書かない。コピーして .env(gitignore 済み)に設定する。
# =====================================================================

# --- Database: Neon Postgres + pgvector ---
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Neon Auth(認証。実値は .env / Vercel のみ) ---
NEON_AUTH_BASE_URL=__neon_console_auth_url__
NEON_AUTH_COOKIE_SECRET=__set_me_32chars_min__

# --- Embeddings: モデルを1つに固定(混在禁止) ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_API_KEY=__set_me__
EMBED_MAX_ROWS=200
# EMBEDDING_SOURCE=fixture   # テスト・ローカル検証のみ。production では指定するとエラー(search-foundation §2.2)

# --- GitHub: SSoT(cc-sier-organization / ai-war-room)の読み取り専用 PAT ---
GITHUB_TOKEN=__read_only_pat__

# --- ai-war-room への書き戻し(Claude Action 用・最小スコープ PAT) ---
WARROOM_PAT=__scoped_pat_for_pr__

# --- 同期(M1) ---
CRON_SECRET=__set_me_random_32chars__
SYNC_MAX_FILES=100
# SYNC_SOURCE=fixture   # 受け入れ・ローカル検証時のみ。production では指定するとエラー(§2.3)

# --- 壁打ち(capture-spar M4)— 3つとも明示必須(既定なし。未設定時 /api/spar は 4xx・他画面に影響なし) ---
# 推奨: SPAR_PROVIDER=openai / SPAR_MODEL=gpt-4o-mini(EMBEDDING_API_KEY と同一アカウントの鍵で可)
SPAR_PROVIDER=__set_me__
SPAR_MODEL=__set_me__
SPAR_API_KEY=__set_me__
# 任意ガード(既定: SPAR_MAX_TURNS=8 / SPAR_CTX_TOPK=3 / SPAR_MAX_INPUT_CHARS=2000 / SPAR_MAX_TOKENS=1024)

# --- 壁打ち Codex モード(codex-spar・ローカル開発限定。本番 Vercel には設定しない) ---
# "1" で壁打ちパネルに Codex モードのチップを表示。ランナーは人間の端末から `npm run codex:serve`。
# NEXT_PUBLIC_CODEX_SPAR=1

# --- Neon 管理 / MCP(開発時) ---
NEON_API_KEY=__set_me__

# --- Claude Action 認証(サブスク / claude-code-action) ---
# サブスク(Claude Pro/Max)認証を使うため Anthropic API キーは不要。
# 認証トークンはローカル .env ではなく GitHub の Secret に置く:
#   Secret 名: CLAUDE_CODE_OAUTH_TOKEN(ローカルで `claude setup-token` を実行して生成)
